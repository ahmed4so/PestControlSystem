APP_NAME="SARIS Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Dates are stored in UTC and shown in this time zone.
APP_DISPLAY_TIMEZONE=Africa/Mogadishu

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saris_portal
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Use MAIL_MAILER=log for local development.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@saris.gov.so"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 (S3-compatible). Disks: r2 (files) and r2_backups (backups).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_BACKUP_BUCKET=

# HMAC key for the national-ID hash, separate from APP_KEY (D-117).
NID_HASH_KEY=
BACKUP_ARCHIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
